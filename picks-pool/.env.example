# Copy to .env.local for local development. Vercel gets these as project env vars.

# Supabase > Project Settings > API. Public by design (RLS is the security boundary).
NEXT_PUBLIC_SUPABASE_URL=https://YOURREF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS: score sync, joins, recap, reminders. Secret.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Vercel sends it as "Authorization: Bearer" to /api/cron/*.
CRON_SECRET=

# Your deployed URL, no trailing slash. Used for invite links and emails.
APP_URL=https://your-app.vercel.app

# Email (optional until you want recaps and reminders). resend.com
RESEND_API_KEY=
EMAIL_FROM="Picks Pool <pool@mail.yourdomain.com>"

# AI recap (optional). console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Push notifications (optional). One key pair per app, made once:
#   npx web-push generate-vapid-keys      (or any VAPID key generator site)
# The public key is public; the private key is a Secret in Vercel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
